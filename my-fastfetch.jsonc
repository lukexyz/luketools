{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "windows",
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": "\u001b[90m│ \u001b[32m󰌢 PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "\u001b[90m│ ├ \u001b[32m CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "\u001b[90m│ ├ \u001b[32m󰡁 GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "\u001b[90m│ ├ \u001b[32m󰾆 RAM",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "\u001b[90m│ └ \u001b[32m Disk",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": "\u001b[90m│ \u001b[33m󰣇 OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "\u001b[90m│ ├ \u001b[33m Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "\u001b[90m│ ├ \u001b[33m󰏖 Packages",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "\u001b[90m│ ├ \u001b[33m Shell",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "\u001b[90m│ └ \u001b[33m Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Uptime / Time─────────────────┐"
    },
    {
      "type": "uptime",
      "key": "\u001b[90m│ \u001b[35m󰅐 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "datetime",
      "key": "\u001b[90m│ └ \u001b[35m Time",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
